<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>C# client SDK for Voice messenger bots: the gRPC API (users, groups, channels, messages, attachments, slash commands) and the realtime gateway.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Voice.Bot.Client.Net</PackageId>
    <Authors>Voice-LLC</Authors>
    <Company>Voice-LLC</Company>
    <PackageProjectUrl>https://github.com/Voice-LLC/Voice.Bot.Client.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Voice-LLC/Voice.Bot.Client.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>voice;bot;sdk;grpc;signalr;chat</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../protos/google/api/http.proto;../../protos/google/api/annotations.proto;../../protos/common.proto" ProtoRoot="../../protos" GrpcServices="None" Access="Internal" />
    <Protobuf Include="../../protos/users.proto;../../protos/groups.proto;../../protos/channels.proto;../../protos/messages.proto;../../protos/attachments.proto;../../protos/interactions.proto" ProtoRoot="../../protos" GrpcServices="Both" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Voice.Bot.Client.Net.Tests" />
    <InternalsVisibleTo Include="Voice.Bot.Client.Net.Testing" />
  </ItemGroup>

</Project>
